# Copy to .env and adjust. Everything here is optional: the stack starts without it.

# Cluster. Lower the threshold (say 50) to watch log compaction and InstallSnapshot.
RAFT_LOG_LEVEL=info
RAFT_SNAPSHOT_THRESHOLD=10000

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Email alerts. Grafana sends the "quorum lost" and "nodes down" alerts here.
# With Gmail, SMTP_PASSWORD has to be an app password, not the account password.
ALERT_EMAIL=
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
